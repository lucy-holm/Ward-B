surface_material_override/0 = ExtResource("m_hw")

; The knob is the ONE part of this fixture that has to read in the dark, and
; that is not decoration. Room 16's soft-lock fix is that the breaker is a
; genuine two-way toggle — you must be able to walk back and turn the lights
; on again — so once thrown, the switch has to stay both findable AND legible
; as thrown. Verified by screenshot: with the knob in hardware_mat the whole
; lever is a black silhouette in an unlit room and its position cannot be
; read at all. Amber unshaded, same idea (and the same house rule) as every
; dispenser slot glow and exit panel in the game.
[node name="Knob" type="MeshInstance3D" parent="Lever"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.245, -0.032)
mesh = SubResource("bm_knob")
surface_material_override/0 = ExtResource("m_glow")

