; Yaw-180 so the readable face points -Z into the room, which MIRRORS local X
; relative to the rest of the fixture: the cross at local x=-0.15 renders on
; the viewer's RIGHT, so the text must sit at POSITIVE local x to land beside
; it rather than through it. At the original 0.0016 pixel_size the word was
; wide enough to overlap the cross entirely.
[node name="Label" type="Label3D" parent="."]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0.105, 0.2, -0.116)
text = "MEDICATION"
modulate = Color(0.09, 0.27, 0.2, 1)
outline_modulate = Color(0.83, 0.87, 0.83, 1)
font_size = 34
outline_size = 4
pixel_size = 0.0012
billboard = 0
no_depth_test = false
horizontal_alignment = 1
vertical_alignment = 1

