; Vision light set into the upper panel, per the corridor reference photo —
; proud steel frame with a low-roughness dark pane, offset a couple cm off
; panel-centre so it doesn't read as machine-perfect. Centred at y=0.6 in
; the panel's clear vertical band (0.28-0.92) so it sits well clear of the
; ID plate above (bottom edge 0.92) and the mid rail below (top edge 0.28).
[node name="VisionFrame" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.015, 0.6, -0.04)
mesh = SubResource("bm_vision_frame")
surface_material_override/0 = ExtResource("m_door")

; GLASS IN FRONT OF ITS SURROUND, not behind it. VisionFrame is a SOLID
; 0.34 x 0.44 box, not a ring, so at z -0.036 the glass sat entirely inside it
; and was invisible from the corridor — the vision light read as a small rusty
; steel plate, which is the opposite of the one feature that tells a player this
; door can be seen through. At -0.051 the pane sits a few millimetres proud of
; the surround's front face, so the surround reads as the bead holding it.
[node name="VisionGlass" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.015, 0.6, -0.051)
mesh = SubResource("bm_vision_glass")
surface_material_override/0 = ExtResource("m_glass")

