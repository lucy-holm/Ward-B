[gd_scene load_steps=15 format=3 uid="uid://wardbfixdoor001"]

; Institutional ward door — composite so it reads as "openable" against the
; now-textured triplanar walls, not as another wall panel. Canonical frame:
; width +X, height +Y, depth +Z, front (the pushable/readable side) faces -Z.
; Origin is the centre of the 2.0 x 3.0 x 0.20 fixture volume. Room scripts
; reposition/rotate the whole node to swing it open — nothing here assumes
; a parent, and there is no collision (the generator supplies the Area3D and
; its collider).
;
; Layered like a real panel door instead of world.ts's canvas-stroke trick
; (makeDoorTexture's strokeRect outlines): jamb (proud trim ring) -> leaf
; (the proud slab) -> two recessed panels sunk behind the leaf's front face,
; so real lights actually shade the recess instead of a flat printed line.
; Kick plate and push bar reuse chain.tres (the project's "worn dark metal"
; look — metallic stays nailed near 0 per MIGRATION_NOTES, sold with
; roughness/normal instead since there's no reflection probe to catch a
; metallic surface).

[ext_resource type="Material" uid="uid://wardbmatd839ab2" path="res://materials/door.tres" id="m_door"]
[ext_resource type="Material" uid="uid://wardbmat5fba6a4" path="res://materials/wall2.tres" id="m_wall2"]
[ext_resource type="Material" uid="uid://wardbmat7d6a4dd" path="res://materials/chain.tres" id="m_chain"]

[sub_resource type="StandardMaterial3D" id="m_plate"]
albedo_color = Color(0.906, 0.925, 0.914, 1)
roughness = 0.55
metallic = 0.0

; Recessed-panel infill — a flat, deliberately darker tone rather than a
; reuse of wall2.tres: in this project's ambient-only lighting (no sky, no
; probes, see MIGRATION_NOTES §Materials) two triplanar materials of similar
; luminance don't separate just because one sits behind the other in Z —
; there's no AO/contact-shadow pass to sell the step. Baking the contrast
; into albedo (like the original's painted outline, but now real geometry
; that still catches a grazing light correctly) is what actually reads.
[sub_resource type="StandardMaterial3D" id="m_panel"]
albedo_color = Color(0.155, 0.185, 0.205, 1)
roughness = 0.8
metallic = 0.0

[sub_resource type="BoxMesh" id="bm_jamb_side"]
size = Vector3(0.10, 3.0, 0.16)
material = ExtResource("m_wall2")

[sub_resource type="BoxMesh" id="bm_jamb_top"]
size = Vector3(2.0, 0.10, 0.16)
material = ExtResource("m_wall2")

; Leaf is NOT one solid slab — a solid box here would occlude the recessed
; panels behind it entirely (a box has no interior visibility; the panels
; would sit geometrically "behind" it but never actually be seen). Instead
; the leaf is rails + stiles with real gaps, and the panels below fill
; those gaps at a set-back Z, like an actual panel door.
[sub_resource type="BoxMesh" id="bm_rail_h"]
size = Vector3(1.80, 0.15, 0.06)
material = ExtResource("m_door")

[sub_resource type="BoxMesh" id="bm_rail_mid"]
size = Vector3(1.80, 0.18, 0.06)
material = ExtResource("m_door")

[sub_resource type="BoxMesh" id="bm_rail_bottom"]
size = Vector3(1.80, 0.45, 0.06)
material = ExtResource("m_door")

[sub_resource type="BoxMesh" id="bm_stile"]
size = Vector3(0.15, 2.28, 0.06)
material = ExtResource("m_door")

[sub_resource type="BoxMesh" id="bm_panel_upper"]
size = Vector3(1.50, 0.95, 0.03)
material = SubResource("m_panel")

[sub_resource type="BoxMesh" id="bm_panel_lower"]
size = Vector3(1.50, 1.15, 0.03)
material = SubResource("m_panel")

[sub_resource type="BoxMesh" id="bm_kick"]
size = Vector3(1.50, 0.40, 0.03)
material = ExtResource("m_chain")

[sub_resource type="BoxMesh" id="bm_bar"]
size = Vector3(0.55, 0.05, 0.045)
material = ExtResource("m_chain")

[sub_resource type="BoxMesh" id="bm_plate"]
size = Vector3(0.70, 0.16, 0.012)
material = SubResource("m_plate")

