[resource]
render_priority = 0
shader = ExtResource("1_shader")
; Padded-cell fabric / mattress ticking: fully matte, so roughness_base and
; roughness_substrate sit close together (no glossy-vs-rough contrast to
; sell). The chip mechanism here reads as TEARS, not enamel chips — larger,
; softer-edged patches (low chip_scale, wide chip_edge_width, low lip), and
; the "rust" tint is repurposed as a dull water/mould stain, not orange
; rust, at low strength. metallic_base is 0 — fabric has no reason for any.
; Palette pass (2026-08, matB): the board's "WORN PADDED-CELL WALL FABRIC"
; panel is a warmer, browner khaki than the previous flat tan (measured
; average ~0.38-0.45 with R notably > B, vs. this material's near-flat
; spread) — warmed and darkened base_color to match. substrate/mould-stain
; nudged toward the same family rather than an independent grey.
shader_parameter/decay = 0.35
shader_parameter/base_color = Color(0.52, 0.465, 0.38, 1)
shader_parameter/substrate_color = Color(0.22, 0.19, 0.15, 1)
shader_parameter/rust_bleed_color = Color(0.30, 0.31, 0.24, 1)
shader_parameter/mottle_tex = SubResource("NoiseTexture2D_pad_mottle")
shader_parameter/normal_tex = SubResource("NoiseTexture2D_pad_normal")
shader_parameter/chip_tex = SubResource("NoiseTexture2D_pad_chip")
shader_parameter/mottle_scale = 1.8
shader_parameter/normal_scale = 6.5
shader_parameter/chip_scale = 1.3
shader_parameter/stretch_y = 1.0
shader_parameter/mottle_strength = 0.26
shader_parameter/normal_strength = 0.55
shader_parameter/roughness_base = 0.85
shader_parameter/roughness_substrate = 0.92
shader_parameter/metallic_base = 0.0
shader_parameter/chip_coverage = 0.85
shader_parameter/chip_edge_width = 0.06
shader_parameter/chip_lip_strength = 0.5
shader_parameter/chip_ao_strength = 0.3
shader_parameter/rust_bleed_strength = 0.2
