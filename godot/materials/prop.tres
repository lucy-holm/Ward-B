[resource]
render_priority = 0
shader = ExtResource("1_shader")
; Furniture: beige moulded plastic (chairs) + painted steel (cabinet/legs)
; share this material, so roughness sits lower than the enamel fixtures
; (plastic has some sheen) and rust bleed is present but moderate — only
; the steel parts should show it, plastic doesn't rust, but there's no
; per-part mask to split them on, so it's tuned as a compromise.
shader_parameter/decay = 0.35
shader_parameter/base_color = Color(0.74, 0.68, 0.56, 1)
shader_parameter/substrate_color = Color(0.29, 0.267, 0.22, 1)
shader_parameter/rust_bleed_color = Color(0.55, 0.31, 0.23, 1)
shader_parameter/mottle_tex = SubResource("NoiseTexture2D_prop_mottle")
shader_parameter/normal_tex = SubResource("NoiseTexture2D_prop_normal")
shader_parameter/chip_tex = SubResource("NoiseTexture2D_prop_chip")
shader_parameter/mottle_scale = 1.1
shader_parameter/normal_scale = 2.2
shader_parameter/chip_scale = 3.5
shader_parameter/stretch_y = 1.0
shader_parameter/mottle_strength = 0.17
shader_parameter/normal_strength = 0.55
shader_parameter/roughness_base = 0.5
shader_parameter/roughness_substrate = 0.85
shader_parameter/metallic_base = 0.0
shader_parameter/chip_coverage = 0.72
shader_parameter/chip_edge_width = 0.025
shader_parameter/chip_lip_strength = 1.1
shader_parameter/chip_ao_strength = 0.3
shader_parameter/rust_bleed_strength = 0.35
