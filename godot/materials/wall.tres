[sub_resource type="FastNoiseLite" id="FastNoiseLite_wall_island"]
; island_tex noise (2026-08, crazing pass): was noise_type=1 (Simplex Smooth,
; 2-octave FBM) — that produces smooth, rounded amoeba blobs, not the "fine
; network of small islands" the PBR board's cracked-paint panel actually
; shows. Switched to Cellular with cellular_return_type=4 (DISTANCE2_SUB,
; i.e. F2-F1): that returns ~0 exactly ON the Voronoi cell boundary (both
; nearest points are ~equidistant there) and rises toward the cell centre —
; the standard "cracked earth"/crazed-paint procedural technique. The peel
; shader thresholds LOW island_tex values as exposed, so this reads as thin
; cracks (low F2-F1) opening onto the substrate, with paint intact in the
; cell interiors (high F2-F1) — exactly inverted from the old shader's
; smooth blob silhouette, and much closer to the reference. fractal_octaves
; pinned to 1 (no FBM layering) so the cell pattern stays crisp rather than
; blurring into the old amoeba look through a different noise function.
noise_type = 2
seed = 303
frequency = 0.085
fractal_octaves = 1
cellular_distance_function = 0
cellular_return_type = 4
cellular_jitter = 0.85

[sub_resource type="NoiseTexture2D" id="NoiseTexture2D_wall_island"]
generate_mipmaps = true
seamless = true
seamless_blend_skirt = 0.25
width = 256
height = 256
noise = SubResource("FastNoiseLite_wall_island")

; Palette pass (2026-08, matB): re-sampled against the PBR material board
; (cracked-paint/damp-plaster panel + the 8-swatch strip). The prior colors
; were a touch too grey/neutral — the board's bone paint carries more
; warm/tan spread (R noticeably > G > B) than a flat "off-white". decay
; nudged 0.13 -> 0.22 so peel islands actually read at a glance instead of
; needing to hunt for them (threshold = mix(0.08,0.66,decay), so this is a
; ~0.05 threshold increase, not a wholesale rebuild of the coverage curve).
; green_cast/rust/grime desaturated toward the board's more muted sage and
; dull rust swatches — the previous tones were more saturated than anything
; in the reference. See wall2.tres for the same deltas applied to its own
; (slightly darker) base tones.
[resource]
render_priority = 0
shader = ExtResource("1_shader")
shader_parameter/decay = 0.22
shader_parameter/paint_clean_color = Color(0.615, 0.565, 0.485, 1)
shader_parameter/paint_soiled_color = Color(0.535, 0.49, 0.415, 1)
shader_parameter/plaster_color = Color(0.50, 0.45, 0.375, 1)
shader_parameter/lath_color = Color(0.40, 0.355, 0.30, 1)
shader_parameter/green_cast_color = Color(0.38, 0.395, 0.31, 1)
shader_parameter/shadow_color = Color(0.32, 0.33, 0.27, 1)
shader_parameter/rust_color = Color(0.56, 0.32, 0.27, 1)
shader_parameter/grime_color = Color(0.36, 0.24, 0.17, 1)
shader_parameter/band_color = Color(0.22, 0.245, 0.235, 1)
shader_parameter/band_height = 1.1
shader_parameter/band_softness = 0.22
shader_parameter/rail_width = 0.025
shader_parameter/mottle_tex = SubResource("NoiseTexture2D_wall_mottle")
shader_parameter/island_tex = SubResource("NoiseTexture2D_wall_island")
shader_parameter/mottle_scale = 0.22
shader_parameter/island_scale = 0.8
shader_parameter/streak_scale = 0.5
shader_parameter/streak_squash = 0.08
shader_parameter/mottle_strength = 0.16
shader_parameter/streak_strength = 0.22
shader_parameter/normal_strength = 1.1
shader_parameter/roughness_paint = 0.55
shader_parameter/roughness_plaster = 0.95
; ao_strength 0.22 -> 0.27: a touch more contact-shadow depth at the peel
; lip so exposed plaster reads as recessed, not just recolored.
shader_parameter/ao_strength = 0.18
shader_parameter/parallax_strength = 0.12
shader_parameter/peel_threshold_min = 0.05
shader_parameter/peel_threshold_max = 0.30
shader_parameter/edge_width_near = 0.07
shader_parameter/edge_width_far = 0.16
shader_parameter/dist_fade_near = 5.0
shader_parameter/dist_fade_far = 18.0
