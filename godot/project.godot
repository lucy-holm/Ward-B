[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="world_static"
3d_physics/layer_3="solid_lucid_only"
3d_physics/layer_4="solid_unmed_only"
3d_physics/layer_5="orderly"
3d_physics/layer_6="interactable"
3d_physics/layer_7="trigger"

[physics]

common/physics_ticks_per_second=60

[rendering]

lights_and_shadows/positional_shadow/atlas_size=2048

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
