; Ward B — Godot 4.7 migration
;
; Renderer note: gl_compatibility (WebGL2), not Forward+. Forward+ on web
; needs WebGPU, which is not broadly available yet, and the brief requires
; "everyone can play it". Cost: no volumetric fog. The state-shift look is
; therefore built from depth fog + glow + Environment adjustments, which all
; work in Compatibility. See MIGRATION_NOTES.md.

config_version=5

[application]

config/name="Ward B"
config/description="First-person psychological puzzle game. Two realities: UNMEDICATED and LUCID."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://core/tuning.gd"
StateManager="*res://autoload/state_manager.gd"
GameState="*res://autoload/game_state.gd"
Telemetry="*res://autoload/telemetry.gd"
WardAudio="*res://autoload/ward_audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

