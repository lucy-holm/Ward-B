[gd_resource type="ShaderMaterial" load_steps=3 format=3 uid="uid://wardbprmenam1"]

; Chipped cream enamel — the sink basin, window sills and reveals; anything
; painted in the ward's original 1970s spec rather than replaced since.
; Deliberately the WARMEST and lightest thing in the palette: the walls are a
; cooler green-grey, so an enamel panel against them separates on hue alone
; even in near-darkness, which is what makes a sink or a sill readable at the
; far end of an unlit corridor.
;
; Realism pass (2026-08): brightened from albedo 0.6/0.595/0.555. The wall
; shader (materials/wall.tres) got its own palette pass first and came out
; warmer and only slightly darker than this — paint_clean_color landed at
; 0.615/0.565/0.485, which is BRIGHTER in R than enamel was and has a wider
; warm/tan spread besides. That quietly inverted the header's own claim:
; enamel had stopped being the lightest, warmest surface in the ward and the
; wall had taken its place. This value re-establishes the gap the header
; describes against the wall's CURRENT baseline rather than its old one — see
; the reference board's "CHIPPED ENAMEL SINK" swatch, which reads distinctly
; whiter than the surrounding wall plaster, not level with it.

; 2026-09-12: shared three-tap wear replaces the flat colour placeholder.
; Retains the authored palette; dirt/chips also vary highlight roughness.

[ext_resource type="Shader" path="res://props/ward_wear.gdshader" id="1_shader"]
[ext_resource type="Texture2D" path="res://props/ward_wear_noise.tres" id="2_noise"]

[resource]
shader = ExtResource("1_shader")
shader_parameter/wear_tex = ExtResource("2_noise")
shader_parameter/paint_color = Color(0.7, 0.655, 0.565, 1)
shader_parameter/substrate_color = Color(0.24, 0.19, 0.145, 1)
shader_parameter/chip_threshold = 0.27
shader_parameter/dirt_strength = 0.19
shader_parameter/paint_roughness = 0.5
shader_parameter/metalness = 0.02
