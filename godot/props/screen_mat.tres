[gd_resource type="StandardMaterial3D" format=3 uid="uid://wardbprmscrn1"]

; Dead CRT glass, and the unlit half of a light troffer's diffuser. Very low
; roughness for a tight specular highlight — the same trick
; fixtures/door_glass_mat.tres uses, and the closest this project gets to
; "glass" without metallic or a reflection probe. Near-black albedo so it
; reads as a dark void with one hot reflection in it.

[resource]
albedo_color = Color(0.035, 0.045, 0.042, 1)
roughness = 0.14
metallic = 0.0
