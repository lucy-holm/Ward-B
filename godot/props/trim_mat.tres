[gd_resource type="StandardMaterial3D" format=3 uid="uid://wardbprmtrim1"]

; Skirting-board paint: the darker, glossier green-grey that institutional
; buildings put on the bottom 100mm of every wall so scuffs do not show. Lower
; roughness than the plaster above it (0.35 vs the wall shader's ~0.9), which
; is what draws a bright line along the floor/wall seam under a ceiling
; fitting and gives a corridor its perspective.

[resource]
albedo_color = Color(0.235, 0.262, 0.248, 1)
roughness = 0.35
metallic = 0.0
