[node name="Card" type="PanelContainer" parent="SettingsPanel/Center"]
layout_mode = 2
size_flags_horizontal = 4
mouse_filter = 2

; The settings card outgrew the screen once it reached five rows: the card is
; bottom-anchored and grows UPWARD (so the live ward stays visible above it —
; see start_overlay.gd's header), and at five rows it pushed the CONFIGURATION
; title off the top of a 1280x900 window entirely. Capping the scroll height at
; a fraction of the viewport in _apply_scale keeps both properties: the ward
; still shows above, and the panel can take more rows later without this
; recurring.
