; Full-rect on purpose: _layout() assigns absolute viewport coordinates to the
; buttons, so this container must span the whole viewport. Anchoring it to the
; bottom-right corner made those coordinates relative to that corner and threw
; both buttons off-screen entirely.
[node name="Buttons" type="Control" parent="Root"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Interact" type="Button" parent="Root/Buttons"]
layout_mode = 0
offset_left = 100.0
offset_top = 10.0
offset_right = 188.0
offset_bottom = 98.0
text = "E"
theme_override_font_sizes/font_size = 30
theme_override_colors/font_color = Color(0.88, 0.93, 0.91, 1)
theme_override_styles/normal = SubResource("SB_button")
theme_override_styles/hover = SubResource("SB_button")
theme_override_styles/pressed = SubResource("SB_button")
theme_override_styles/focus = SubResource("SB_button")

